{
  "hooks": {
    "SessionStart": [
      {"hooks": [{"type": "command", "command": "python3 \"${CLAUDE_PLUGIN_ROOT}/bin/watch-your-step.py\" git-guard ensure", "timeout": 10}]},
      {"hooks": [{"type": "command", "command": "python3 \"${CLAUDE_PLUGIN_ROOT}/bin/watch-your-step.py\" primer", "timeout": 5}]}
    ],
    "PreToolUse": [
      {"matcher": "Bash|Read|Write|Edit|MultiEdit|NotebookEdit",
       "hooks": [{"type": "command", "command": "python3 \"${CLAUDE_PLUGIN_ROOT}/bin/watch-your-step.py\" check", "timeout": 10}]}
    ]
  }
}
